<?xml version="1.0" encoding="utf-8"?>
<!--
  The plate behind the mark: the brand's near-black, with a green pool of light
  at the centre so the tick looks lit rather than pasted on.

  The pool is one radial gradient rather than stacked discs - with the mark's
  centre now open, stepped discs would show as rings.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/brand_background"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="46"
                android:startColor="@color/brand_glow_centre"
                android:endColor="@color/brand_glow_edge" />
        </aapt:attr>
    </path>
</vector>
