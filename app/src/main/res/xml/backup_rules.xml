<?xml version="1.0" encoding="utf-8"?>
<!--
   Full-backup policy for devices older than Android 12 (API 24-30).

   Same rule as data_extraction_rules.xml: the learner files stay on the phone.
   The app's own .xlsx export is the supported way to move a record.
-->
<full-backup-content>
    <exclude domain="file" path="nfc-attendance/" />
    <exclude domain="external" path="reports/" />
</full-backup-content>
